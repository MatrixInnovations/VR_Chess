{
  "name": "@vr-chess/fridae-clock",
  "private": true,
  "type": "module",
  "description": "Fridae lane: Lichess and offline chess-clock domain logic. No network and no React view.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/**/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=90 --test-coverage-branches=75 --test test/**/*.test.ts"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.4.5"
  }
}
