# Public Lichess OAuth client id. Create one at https://lichess.org/account/oauth/app
# The redirect URI registered on that app must be the site origin with a trailing slash.
# Local: http://localhost:3000/
# The page uses `${window.location.origin}/` and does not read a different URI from the environment.
# The access token is stored in sessionStorage. Do not commit a token.
NEXT_PUBLIC_LICHESS_CLIENT_ID=
